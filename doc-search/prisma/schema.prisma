generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") 

}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookmarks    Bookmark[]
  codeSnippets CodeSnippet[]
  notes        Note[]
  searches     Search[]
}

model DocumentationSource {
  id          String     @id @default(cuid())
  name        String
  baseUrl     String
  apiEndpoint String?
  type        SourceType
  language    String?
  framework   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  enabled     Boolean    @default(true)
  pages       DocPage[]

  @@index([name])
}

model DocPage {
  id          String              @id @default(cuid())
  url         String
  title       String
  content     String
  sourceId    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  bookmarks   Bookmark[]
  snippets    CodeSnippet[]
  source      DocumentationSource @relation(fields: [sourceId], references: [id])
  searchIndex SearchIndex?

  @@index([url])
  @@index([title])
}

model SearchIndex {
  id        String   @id @default(cuid())
  pageId    String   @unique
  keywords  String[]
  content   String
  metadata  Json
  updatedAt DateTime @updatedAt
  page      DocPage  @relation(fields: [pageId], references: [id])

  @@index([keywords])
}

model Search {
  id        String   @id @default(cuid())
  query     String
  userId    String
  timestamp DateTime @default(now())
  results   Json
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([query])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  pageId    String
  folder    String?
  createdAt DateTime @default(now())
  page      DocPage  @relation(fields: [pageId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  notes     Note[]

  @@unique([userId, pageId])
  @@index([userId])
  @@index([pageId])
}

model CodeSnippet {
  id          String   @id @default(cuid())
  title       String
  code        String
  language    String
  userId      String
  pageId      String?
  description String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  page        DocPage? @relation(fields: [pageId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([language])
  @@index([tags])
}

model Note {
  id         String   @id @default(cuid())
  content    String
  userId     String
  bookmarkId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([bookmarkId])
}

enum SourceType {
  OFFICIAL
  COMMUNITY
  OTHER
}
